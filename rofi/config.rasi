/* ┌─────────────────────────────────────────────┐
   │  rofi · Nord                                │
   └─────────────────────────────────────────────┘
   Previous config saved as config.rasi.bak */

@theme "/dev/null"   /* start from a blank slate, not rofi's default theme */

configuration {
    modes: "combi";
    combi-modes: "window,run,drun";
    drun-display-format: "{name}";
    window-format: "{t:45}  ·  {c}";
    font: "JetBrainsMono Nerd Font 11";

    show-icons: true;
    sidebar-mode: false;
    scroll-method: 1;
    matching: "prefix";
    sort: true;
    sorting-method: "normal";
    click-to-exit: true;
    combi-hide-mode-prefix: true;

    display-drun: "󰍉";
    display-run: "";
    display-window: "󰖯";
    display-combi: "󰍉";
    display-ssh: "󰣀";
}

* {
    /* Nord */
    nord0:  #2E3440;  nord1:  #3B4252;  nord2:  #434C5E;  nord3:  #4C566A;
    nord4:  #D8DEE9;  nord5:  #E5E9F0;  nord6:  #ECEFF4;
    nord7:  #8FBCBB;  nord8:  #88C0D0;  nord9:  #81A1C1;  nord10: #5E81AC;
    nord11: #BF616A;  nord12: #D08770;  nord13: #EBCB8B;  nord14: #A3BE8C;  nord15: #B48EAD;

    bg:          #2E3440F2;   /* nord0 @ 95% */
    bg-alt:      @nord1;
    bg-selected: @nord2;
    fg:          @nord4;
    fg-bright:   @nord6;
    fg-muted:    #D8DEE966;   /* nord4 @ 40% */
    accent:      @nord8;
    border-col:  @nord9;      /* matches Hyprland active border */
    urgent:      @nord11;

    background-color: transparent;
    text-color: @fg;
    border: 0;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    location: center;
    width: 560px;
    background-color: @bg;
    border: 2px;
    border-color: @border-col;
    border-radius: 12px;
    padding: 16px;
}

mainbox {
    spacing: 14px;
    children: [inputbar, listview, message];
}

inputbar {
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 12px 16px;
    spacing: 12px;
    children: [prompt, entry];
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font 14";
    vertical-align: 0.5;
}

entry {
    text-color: @fg-bright;
    placeholder: "Search…";
    placeholder-color: @fg-muted;
    cursor: text;
    vertical-align: 0.5;
}

listview {
    lines: 7;
    columns: 1;
    spacing: 4px;
    fixed-height: true;
    scrollbar: false;
    cycle: true;
}

element {
    border-radius: 8px;
    padding: 9px 12px;
    spacing: 14px;
    cursor: pointer;
}

element-icon {
    size: 26px;
    vertical-align: 0.5;
    cursor: inherit;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
    cursor: inherit;
}

element normal.normal,
element alternate.normal   { background-color: transparent; text-color: @fg; }
element normal.active,
element alternate.active   { background-color: transparent; text-color: @accent; }
element normal.urgent,
element alternate.urgent   { background-color: transparent; text-color: @urgent; }

element selected.normal    { background-color: @bg-selected; text-color: @fg-bright; }
element selected.active    { background-color: @bg-selected; text-color: @accent; }
element selected.urgent    { background-color: @urgent;      text-color: @nord0; }

message {
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 10px 14px;
}

textbox {
    text-color: @fg;
    vertical-align: 0.5;
}

button {
    background-color: @bg-alt;
    text-color: @fg-muted;
    border-radius: 8px;
    padding: 8px 12px;
}

button selected {
    background-color: @bg-selected;
    text-color: @accent;
}
